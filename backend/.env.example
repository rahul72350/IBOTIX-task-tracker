DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_actual_postgres_password
DB_NAME=ibotix_pm

PORT=8000
CORS_ORIGIN=http://localhost:5173

JWT_SECRET=any-long-random-string-you-like

ADMIN_EMAIL=admin@ibotix.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin User

UPLOAD_DIR=uploads

# Leave SMTP_HOST blank to just print deadline emails to the console
# instead of sending them — useful while you're testing. Fill these in
# with a real SMTP provider (Gmail app password, SendGrid, etc.) to send
# for real.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Ibotix PM <no-reply@ibotix.com>
# Who gets the deadline alerts. Defaults to ADMIN_EMAIL above if left blank.
ADMIN_NOTIFY_EMAIL=
DEADLINE_WARNING_DAYS=2
DEADLINE_CHECK_INTERVAL_MINUTES=60

# Cloudflare R2 (object storage for attachments) — leave all blank to use
# local disk storage automatically instead. See README for setup steps.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_SIGNED_URL_EXPIRY=300

# Self-service password reset (forgot password email)
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRY_MINUTES=30
